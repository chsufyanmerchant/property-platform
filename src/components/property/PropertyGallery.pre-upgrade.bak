"use client";

import Image from "next/image";
import { useState } from "react";
import Icon, { type IconName } from "@/components/ui/Icon";
import { cn } from "@/lib/utils";
import type { Property } from "@/types/property";

interface PropertyGalleryProps {
  property: Property;
}

const typeIcon: Record<Property["type"], IconName> = {
  house: "home",
  apartment: "building",
  plot: "landPlot",
  commercial: "store",
};

export default function PropertyGallery({ property }: PropertyGalleryProps) {
  const [activeIndex, setActiveIndex] = useState(0);
  const [imageError, setImageError] = useState(false);

  const hasImage = Boolean(property.image) && !imageError;

  const goTo = (index: number) => {
    setActiveIndex(index);
    setImageError(false);
  };

  return (
    <div>
      {/* Main image */}
      <div className="relative aspect-[16/10] overflow-hidden rounded-2xl border border-line bg-slate-100 sm:aspect-[16/9]">
        {hasImage ? (
          <Image
            src={property.image}
            alt={property.title}
            fill
            priority
            sizes="(max-width: 1024px) 100vw, 70vw"
            className="object-cover transition-transform duration-500"
            onError={() => setImageError(true)}
          />
        ) : (
          <div className="flex h-full w-full items-center justify-center bg-slate-200">
            <Icon
              name={typeIcon[property.type]}
              className="h-20 w-20 text-slate-400 sm:h-24 sm:w-24"
            />
          </div>
        )}

        {/* Featured badge */}
        {property.isFeatured && (
          <span className="absolute left-4 top-4 z-10 inline-flex items-center gap-1 rounded-full bg-gold px-3 py-1.5 text-xs font-semibold text-white shadow-sm">
            <Icon name="star" className="h-3.5 w-3.5" />
            Featured
          </span>
        )}

        {/* Previous */}
        <button
          type="button"
          onClick={() => goTo(activeIndex - 1)}
          aria-label="Previous image"
          className="absolute left-3 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-ink shadow-sm transition hover:bg-white"
        >
          <Icon name="chevronLeft" className="h-5 w-5" />
        </button>

        {/* Next */}
        <button
          type="button"
          onClick={() => goTo(activeIndex + 1)}
          aria-label="Next image"
          className="absolute right-3 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-ink shadow-sm transition hover:bg-white"
        >
          <Icon name="chevronRight" className="h-5 w-5" />
        </button>

        {/* Counter */}
        <span className="absolute bottom-3 right-3 z-10 rounded-full bg-ink-deep/70 px-2.5 py-1 text-xs font-medium text-white">
          1 / 1
        </span>
      </div>

      {/* Thumbnail */}
      <div className="mt-3">
        <button
          type="button"
          onClick={() => goTo(0)}
          aria-label="Show property image"
          aria-current={activeIndex === 0}
          className={cn(
            "relative aspect-[4/3] w-28 overflow-hidden rounded-xl border-2 transition",
            activeIndex === 0
              ? "border-teal"
              : "border-transparent opacity-70 hover:opacity-100"
          )}
        >
          {property.image && !imageError ? (
            <Image
              src={property.image}
              alt={`${property.title} thumbnail`}
              fill
              sizes="112px"
              className="object-cover"
              onError={() => setImageError(true)}
            />
          ) : (
            <div className="flex h-full w-full items-center justify-center bg-slate-200">
              <Icon
                name={typeIcon[property.type]}
                className="h-6 w-6 text-slate-400"
              />
            </div>
          )}
        </button>
      </div>
    </div>
  );
}
